__pycache__/
*.pyc
# logs are not versioned: run logs of all codes (*.log, *.out), the packed elfe3D logs (logs.tar.gz) and the
# log.txt of the series and empymod runs
*.log
*.out
log.txt
logs.tar.gz
# LaTeX: only .tex and .pdf are kept, no intermediate files of the compilation
*.aux
*.bbl
*.blg
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.xdv
*.nav
*.snm
*.vrb
# series coefficients (intermediate product of run_series.py, reproducible from control.toml); the data are fields.*
coefficients.npz
# empymod time-domain runs: one file per job, merged into out/transients.*; kept locally so that a run can resume
tests/validation/1D/empymod_time/cases/*/empymod/out/parts/
# packaging (pip install .) and local outputs of the quick start and of the paper scripts
*.egg-info/
/build/
/dist/
/examples/results/
/examples/*/results/
/out/
# validation reports: written by the report scripts and compiled locally; only the overall report is tracked, as
# validation_report.pdf in the repository root
tests/validation/report/
tests/validation/*/*/report/
# quick-look profile plots of plot_profiles_freq.py / plot_profile.py (the comparisons are in validation_report.pdf)
tests/validation/3D/*/cases/*/comparison/profile_*.png
tests/validation/3D/*/cases/*/comparison/profile_*.pdf
